{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "titulo": {
      "type": "string",
      "required": true
    },
    "fecha": {
      "type": "date",
      "required": true
    },
    "portada": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "preview": {
      "type": "text"
    },
    "contenido": {
      "type": "dynamiczone",
      "components": [
        "shared.text",
        "shared.imagen",
        "shared.galeria-imagenes",
        "shared.tabla"
      ],
      "required": true
    }
  }
}
